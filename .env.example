# Server-side only. Never expose this value in VITE_* variables or generated files.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key

# Stable coding-capable default as of August 2026.
FORGEWEB_GEMINI_MODEL=gemini-3.7-flash

# Set to deterministic to run demos without external model calls.
FORGEWEB_GENERATION_MODE=gemini
