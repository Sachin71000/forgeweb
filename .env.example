# Server-side only. Never use VITE_* names and never commit .env.local.
# Live runtime dependencies: run npm run runtime:prepare once with Docker running.
# Generated-app records persist in per-project Docker volumes, separate from history.
FORGEWEB_RUNTIME_NODE_VOLUME=forgeweb-runtime-node-deps-v1
FORGEWEB_RUNTIME_PYTHON_VOLUME=forgeweb-runtime-python-deps-v1
# Optional local gateway. Enable only after adding its unified API key.
# When enabled, architecture, React and Python requests use its routing chain.
# Existing direct-provider settings below are preserved; disable to return to them.
FORGEWEB_FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
# Pipeline: Groq then OpenRouter for frontend; Gemini for architecture/backend.
# Optional extra Gemini credentials provide service failover, not quota bypass.
GROQ_API_KEY=replace_with_your_rotated_groq_key
OPENROUTER_API_KEY=replace_with_your_rotated_openrouter_key
FORGEWEB_GROQ_MODEL=qwen/qwen3.8-27b
FORGEWEB_OPENROUTER_MODEL=openai/gpt-5.3-codex

# Required for architecture and backend generation.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_FALLBACK_API_KEY_1=
GEMINI_FALLBACK_API_KEY_2=
FORGEWEB_GEMINI_MODEL=gemini-3-flash-preview

# auto prefers Gemini + Groq/OpenRouter. Also accepts split, gemini-python,
# dual, openrouter, groq, gemini, deterministic.
FORGEWEB_GENERATION_MODE=frontend-dual-gemini-backend

# Direct Sol is opt-in: set FORGEWEB_GENERATION_MODE=openai in .env.local.
# Fixed $1 cumulative local testing allowance, no automatic paid fallback.
OPENAI_API_KEY=
# Architecture/backend override when Gemini is unavailable: gemini or groq.
# gemini tries enabled Gemini slots then Groq; groq tries Groq then enabled slots.
FORGEWEB_BACKEND_PROVIDER=gemini
# Keep Groq source requests paced/file-level even when Gemini handles backend first.
FORGEWEB_GROQ_FILE_MODE=true
# Comma-separated key slots to skip without deleting saved keys; empty by default.
FORGEWEB_GEMINI_DISABLED_SLOTS=
STITCH_API_KEY=
FORGEWEB_STITCH_ENABLED=false
# Private local rejection evidence and syntax-checked backend-file reuse.
FORGEWEB_GENERATION_DIAGNOSTICS=false

# Optional custom MCP inventory inspection. Backend-only endpoint allowlist.
# Streamable HTTP endpoints only; HTTP is limited to loopback. Restart after edits.
# Example: [{"id":"design","name":"Design tools","url":"https://your-server.example/mcp","tokenEnv":"DESIGN_MCP_TOKEN"}]
FORGEWEB_MCP_SERVERS=[]
# DESIGN_MCP_TOKEN=your_server_side_bearer_token
# Existing STITCH_API_KEY automatically enables the read-only Stitch connector.
# Optional Supabase DEVELOPMENT project, schema-only reads (no SQL or row access).
# Use a dedicated development-project credential; never production credentials.
SUPABASE_MCP_PROJECT_REF=
SUPABASE_MCP_TOKEN=
FORGEWEB_SUPABASE_ENVIRONMENT=development
## Local code-only structural indexing. No model API or cloud extraction.
FORGEWEB_GRAPHIFY_ENABLED=true
