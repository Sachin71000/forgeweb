# Server-side only. Never use VITE_* names and never commit .env.local.
# Pipeline: Groq then OpenRouter for frontend; Gemini for architecture/backend.
# Optional extra Gemini credentials provide service failover, not quota bypass.
GROQ_API_KEY=replace_with_your_rotated_groq_key
OPENROUTER_API_KEY=replace_with_your_rotated_openrouter_key
FORGEWEB_GROQ_MODEL=qwen/qwen3.8-27b
FORGEWEB_OPENROUTER_MODEL=openai/gpt-5.3-codex

# Required for architecture and backend generation.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_FALLBACK_API_KEY_1=
GEMINI_FALLBACK_API_KEY_2=
FORGEWEB_GEMINI_MODEL=gemini-3-flash-preview

# auto prefers Gemini + Groq/OpenRouter. Also accepts split, gemini-python,
# dual, openrouter, groq, gemini, deterministic.
FORGEWEB_GENERATION_MODE=frontend-dual-gemini-backend
