{
  "name": "forgeweb-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "graph:refresh": "node --experimental-strip-types scripts/build-forgeweb-graph.ts",
    "runtime:prepare": "node --experimental-strip-types scripts/prepare-runtime.ts",
    "dev": "node --use-system-ca ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "dev:api": "node --use-system-ca --experimental-strip-types server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.build.json",
    "build:api": "tsc -p tsconfig.server.build.json",
    "start:api": "node --use-system-ca dist-server/index.js",
    "preview": "node --use-system-ca ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --pretty false",
    "test": "node --experimental-strip-types --test server/tests/*.test.ts"
  },
  "dependencies": {
    "@babel/parser": "7.29.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@google/stitch-sdk": "^0.3.5",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.2.4"
  }
}
